# ── Secrets / Credentials ─────────────────────────────────────────────────────
# NEVER commit .env files with real secrets.
# Use .env.example as the template. Copy to .env and fill locally.
.env
.env.local
.env.production
.env.staging

# ── Android Keystores & Signing Keys ──────────────────────────────────────────
# Keystores and signing properties contain private keys and must NEVER be committed.
*.jks
*.keystore
key.properties
key.properties.local

# ── Database Dumps / Backups ──────────────────────────────────────────────────
# SQL dumps, database backups, and raw exports must never be committed.
*.sql
*.dump
*.bak
*.backup
*.pg_dump
*.dump.enc
*.tar.gz.enc
backups/
wal_archive/
backup/*.zip

# ── Node / NestJS ─────────────────────────────────────────────────────────────
node_modules/
dist/
.turbo/

# ── Flutter / Dart ─────────────────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
*.g.dart
*.freezed.dart

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
*.swp
